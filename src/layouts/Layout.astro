---
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Absolute URL of the current page, used for og:url + canonical. */
  canonical: string
  /** Per-page robots directive. Defaults to allow-everything. */
  robots?: string
  /** Per-page Schema.org JSON-LD. If omitted, the homepage @graph is emitted. */
  jsonLd?: object
  /** OG image override; absolute URL recommended. */
  ogImage?: string
  /** OG image width/height for accurate previews. */
  ogImageWidth?: number
  ogImageHeight?: number
  ogImageAlt?: string
}

const {
  title,
  description,
  canonical,
  robots = 'index,follow,max-image-preview:large,max-snippet:-1',
  jsonLd,
  ogImage = 'https://www.tw-services.ch/og-image.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = 'TW Services: Vermarktung für Neubauprojekte mit dem Portal TWS Studio',
} = Astro.props

// Default homepage @graph — reused on any page that doesn't override jsonLd.
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.tw-services.ch/#organization',
      name: 'TW Services',
      legalName: 'TW Projects GmbH',
      url: 'https://www.tw-services.ch/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.tw-services.ch/logo.png',
        width: 512,
        height: 512,
      },
      email: 'info@tw-services.ch',
      telephone: '+41445056372',
      vatID: 'CHE-440.628.856',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Breitenmattstrasse 69',
        postalCode: '8635',
        addressLocality: 'Dürnten',
        addressRegion: 'ZH',
        addressCountry: 'CH',
      },
      parentOrganization: {
        '@type': 'Organization',
        '@id': 'https://www.tw-p.ch/#organization',
        name: 'TW Projects GmbH',
        url: 'https://www.tw-p.ch/',
      },
      areaServed: [
        { '@type': 'Country', name: 'Switzerland' },
        { '@type': 'Country', name: 'Germany' },
        { '@type': 'Country', name: 'Austria' },
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.tw-services.ch/#professionalservice',
      name: 'TW Services',
      image: 'https://www.tw-services.ch/logo.png',
      url: 'https://www.tw-services.ch/',
      email: 'info@tw-services.ch',
      telephone: '+41445056372',
      priceRange: '$$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Breitenmattstrasse 69',
        postalCode: '8635',
        addressLocality: 'Dürnten',
        addressRegion: 'ZH',
        addressCountry: 'CH',
      },
      areaServed: [
        { '@type': 'Country', name: 'Switzerland' },
        { '@type': 'Country', name: 'Germany' },
        { '@type': 'Country', name: 'Austria' },
      ],
      serviceType: 'Vermarktung für Neubauprojekte: Projektvideo, Meta-Anzeigen, Landingpage und Kampagne',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.tw-services.ch/#website',
      url: 'https://www.tw-services.ch/',
      name: 'TW Services',
      publisher: { '@id': 'https://www.tw-services.ch/#organization' },
      inLanguage: 'de-CH',
    },
  ],
}

const finalJsonLd = jsonLd ?? defaultJsonLd
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F5F7FA" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TW Services" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:locale:alternate" content="de_AT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
